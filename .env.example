# Configuração do Antimicrobiano Inteligente.
# Copie para .env (cp .env.example .env) e ajuste os valores. O arquivo .env não é versionado.
# Variáveis definidas no sistema têm prioridade sobre este arquivo.

# Banco de dados (SQLAlchemy). O arquivo SQLite é criado na primeira execução.
AMI_DATABASE_URL=sqlite:///./antimicrobiano.db

# Autenticação (RF17). Gere um segredo com pelo menos 32 caracteres, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio: a API gera um segredo temporário a cada início e os tokens deixam de valer ao reiniciar.
AMI_JWT_SEGREDO=
AMI_JWT_EXPIRACAO_MINUTOS=60

# Logs estruturados em JSON: DEBUG, INFO, WARNING, ERROR ou CRITICAL.
AMI_LOG_NIVEL=INFO

# Parâmetros clínicos do motor de regras (RNF11).
AMI_TIMEOUT_DIAS=3
AMI_LIMITE_PROFILAXIA_DIAS=1
AMI_JANELA_CULTURA_DIAS=7
AMI_MINIMO_ISOLADOS=30

# Senha dos usuários fictícios criados por "python -m antimicrobiano.seed" (apenas demonstração).
AMI_SENHA_DEMO=senha-demo
